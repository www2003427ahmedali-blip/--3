<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" 
    android:orientation="vertical" 
    android:background="?attr/colorKeyboard" 
    android:hardwareAccelerated="false">
  
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="40dp"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:background="?attr/colorKeyboard">
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="AI Chat"
        android:textColor="?android:attr/textColorPrimary"
        android:paddingLeft="12dp"
        android:textSize="14sp"/>
  </LinearLayout>
  
  <ScrollView 
      android:id="@+id/ai_chat_scroll"
      android:layout_width="match_parent"
      android:layout_height="@dimen/clipboard_view_height">
    <LinearLayout 
        android:id="@+id/ai_chat_messages"
        android:orientation="vertical" 
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"/>
  </ScrollView>
  
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:padding="4dp">
    <EditText
        android:id="@+id/ai_chat_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="Ask AI..."
        android:inputType="text"
        android:singleLine="true"/>
    <Button
        android:id="@+id/ai_chat_send"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Send"/>
  </LinearLayout>
  
  <juloo.keyboard2.Keyboard2View 
      layout="@xml/ai_chat_bottom_row" 
      android:layout_width="fill_parent" 
      android:layout_height="wrap_content" 
      android:background="?attr/colorKeyboard"/>
</LinearLayout>
